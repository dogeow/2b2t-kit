diff --git a/src/test/java/dev/twob2tkit/chopper/ChopperToolWiringTest.java b/src/test/java/dev/twob2tkit/chopper/ChopperToolWiringTest.java
new file mode 100644
--- /dev/null
+++ b/src/test/java/dev/twob2tkit/chopper/ChopperToolWiringTest.java
@@ -0,0 +1,53 @@
+package dev.twob2tkit.chopper;
+
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.tree.*;
+import java.util.*;
+import static org.junit.jupiter.api.Assertions.*;
+
+class ChopperToolWiringTest {
+    private ClassNode read() throws Exception {
+        var node = new ClassNode();
+        try (var in = getClass().getResourceAsStream("/dev/twob2tkit/chopper/AutoChopper.class")) {
+            assertNotNull(in);
+            new ClassReader(in).accept(node, 0);
+        }
+        return node;
+    }
+    private MethodNode method(String name) throws Exception {
+        return read().methods.stream().filter(m -> m.name.equals(name)).findFirst().orElseThrow();
+    }
+    private List<String> calls(String name) throws Exception {
+        var calls = new ArrayList<String>();
+        for (var instruction : method(name).instructions)
+            if (instruction instanceof MethodInsnNode call) calls.add(call.name);
+        return calls;
+    }
+    @Test void axeAndShearsUseTheSameDurabilityCheckedSelection() throws Exception {
+        assertTrue(calls("selectAxe").contains("selectToolType"));
+        assertTrue(calls("selectShears").contains("selectToolType"));
+        assertTrue(calls("selectToolType").containsAll(List.of("chooseSlot", "usableTool", "selectSlot")));
+        assertTrue(calls("usableTool").contains("tooWorn"));
+        assertTrue(calls("selectSafeHand").containsAll(List.of("chooseSlot", "selectSlot", "isDamageableItem")));
+    }
+    @Test void failedSafeSelectionStopsBeforeAnyMiningAction() throws Exception {
+        var mine = method("mine");
+        AbstractInsnNode selected = null;
+        for (var instruction : mine.instructions)
+            if (instruction instanceof MethodInsnNode call && call.name.equals("selectTool")) selected = instruction;
+        assertNotNull(selected);
+        assertInstanceOf(JumpInsnNode.class, selected.getNext());
+        var branch = (JumpInsnNode) selected.getNext();
+        boolean stopped = false, returned = false;
+        for (var instruction = branch.getNext(); instruction != branch.label; instruction = instruction.getNext()) {
+            assertNotNull(instruction);
+            if (instruction instanceof MethodInsnNode call) {
+                stopped |= call.name.equals("stop");
+                assertFalse(call.name.equals("startDestroyBlock") || call.name.equals("continueDestroyBlock"));
+            }
+            returned |= instruction.getOpcode() == org.objectweb.asm.Opcodes.IRETURN;
+        }
+        assertTrue(stopped && returned);
+    }
+}
